# Токен бота от @BotFather. Бот должен быть админом целевого канала с правом публикации.
BOT_TOKEN=

# Обработка текста постов: любой OpenAI-совместимый API.
# По умолчанию — OVHcloud AI Endpoints без ключа (2 запроса/мин, хватает для канала).
LLM_PROVIDER=openai
LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
LLM_MODEL=Qwen3.8-27B
LLM_API_KEY=
LLM_VISION=true
# LLM_RPM=0
#
# Альтернативы (бесплатно, нужен ключ):
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1               LLM_MODEL=qwen/qwen3.8-27b
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1                 LLM_MODEL=google/gemma-4-31b-it:free
#   Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-3.5-flash-lite
#   Z.ai:        LLM_BASE_URL=https://api.z.ai/api/paas/v4                 LLM_MODEL=GLM-4.6V-Flash
#   Cloudflare:  LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1  LLM_MODEL=@cf/google/gemma-4-26b-a4b-it
#   SambaNova:   LLM_BASE_URL=https://api.sambanova.ai/v1                  LLM_MODEL=gemma-4-31B-it
# Без нейросети, на правилах: LLM_PROVIDER=none

# Либо Claude: LLM_PROVIDER=anthropic и ключ с console.anthropic.com
# ANTHROPIC_API_KEY=

# User-аккаунт для чтения каналов-источников: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Прокси ТОЛЬКО для Telegram (бот, аккаунт-читатель, telegra.ph). Остальное (модель, маркетплейсы) — напрямую.
# auto — сам найдёт локальный прокси на 127.0.0.1:1080 (SOCKS5) или :8118 (HTTP), иначе напрямую.
# Явно: socks5://127.0.0.1:1080 · http://127.0.0.1:8118 · none — всегда напрямую.
TG_PROXY=auto

# MAX (max.ru): токен бота — business.max.ru → Чат-боты → ⋮ → Настройки. Пусто — MAX выключен.
# Канал MAX для каждого канала Telegram включается в боте командой /max.
MAX_TOKEN=

# Telegram user id администраторов через запятую (узнать: @userinfobot)
ADMIN_IDS=

# Необязательно
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# DATA_DIR=data
